{
  "name": "browminal",
  "version": "1.0.0",
  "description": "A personal desktop web browser built on Electron",
  "main": "./out/main/index.js",
  "author": "Saif",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:web && bun run typecheck:test",
    "test": "bun test",
    "smoke": "bun scripts/smoke.ts",
    "start": "electron-vite preview",
    "dev": "bun run build:native && electron-vite dev",
    "build": "bun run build:native && bun run typecheck && electron-vite build",
    "build:native": "bun scripts/build-native.ts",
    "postinstall": "bun run build:native && electron-builder install-app-deps",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "bun run build:native && electron-vite build && electron-builder --mac",
    "build:linux": "bun run build:native && electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.67.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
